# Copy this file to `.env` and fill in the value.
#
# Web3Forms access key — powers the contact form.
# Get one free (no account needed) at https://web3forms.com:
#   1. Enter karthiksuru06@gmail.com
#   2. The access key is emailed to you immediately
#   3. Paste it below, then restart `npm run dev`
#
# This key is safe to commit and safe to expose in the browser bundle —
# it only permits sending mail to the address it was registered with.
# Until it is set, the form shows a "please email me directly" message
# rather than silently discarding submissions.
VITE_WEB3FORMS_KEY=

# Chat (optional — the chat panel shows an offline message until set)
OPENROUTER_API_KEY=
# Optional: override the default model (meta-llama/llama-3.3-70b-instruct)
OPENROUTER_MODEL=

# Bot check (optional). Create a Turnstile widget at
# https://dash.cloudflare.com → Turnstile, paste the pair here.
VITE_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Rate limiting: without these, limits are per-instance memory (fine for one
# region). With an Upstash Redis REST pair, limits are shared globally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Extra allowed browser origins, comma separated (rarely needed).
ALLOWED_ORIGINS=
